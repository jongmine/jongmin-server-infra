---
groups:
  - name: sallang_alerts
    interval: 30s
    rules:
      - alert: SallangContainerDown
        expr: absent(container_last_seen{name=~".*sallang.*"})
        for: 1m
        labels:
          severity: critical
          team: sallang
        annotations:
          summary: "Sallang container is down"
          description: "Sallang service container has been down for more than 1 minute"

      - alert: SallangHighErrorRate
        expr: rate(http_server_requests_seconds_count{status=~"5..",team="sallang"}[5m]) / (rate(http_server_requests_seconds_count{team="sallang"}[5m]) + 1e-9) > 0.01
        for: 3m
        labels:
          severity: warning
          team: sallang
        annotations:
          summary: "High error rate in Sallang service"
          description: {% raw %}"Sallang 5xx error rate is above 1% for more than 3 minutes (current: {{ $value | humanizePercentage }})"{% endraw %}

      - alert: SallangHighLatency
        expr: histogram_quantile(0.99, sum by (le)(rate(http_server_requests_seconds_bucket{team="sallang"}[5m]))) > 2
        for: 5m
        labels:
          severity: warning
          team: sallang
        annotations:
          summary: "High latency in Sallang service"
          description: {% raw %}"Sallang P99 latency is above 2 seconds (current: {{ $value | humanizeDuration }})"{% endraw %}

      - alert: SallangMatchingQueueTooLong
        expr: matching_match_queue_length{team="sallang"} > 1000
        for: 5m
        labels:
          severity: warning
          team: sallang
        annotations:
          summary: "Matching queue is too long"
          description: {% raw %}"Sallang matching queue length is above 1000 (current: {{ $value }})"{% endraw %}

      - alert: SallangHighMemoryUsage
        expr: |
          (
            container_memory_working_set_bytes{name=~".*sallang.*"}
            /
            container_spec_memory_limit_bytes{name=~".*sallang.*"}
          ) * 100 > 85
          and
          container_spec_memory_limit_bytes{name=~".*sallang.*"} > 0
        for: 5m
        labels:
          severity: warning
          team: sallang
        annotations:
          summary: "Sallang container memory usage is high"
          description: {% raw %}"Sallang container is using more than 85% of its memory limit (current: {{ $value | humanize }}%)"{% endraw %}

      - alert: SallangDevAny5xx
        expr: |
          (
            increase(http_server_requests_seconds_count{status=~"5..", application="sallang-backend-dev"}[5m]) > 0
          )
          or
          (
            http_server_requests_seconds_count{status=~"5..", application="sallang-backend-dev"} > 0
            unless
            http_server_requests_seconds_count{status=~"5..", application="sallang-backend-dev"} offset 5m
          )
        for: 0m
        labels:
          severity: warning
          team: sallang
          environment: dev
        annotations:
          summary: "Sallang dev returned 5xx"
          description: {% raw %}"Sallang dev returned one or more 5xx responses in the last 5 minutes (count: {{ $value | humanize }})"{% endraw %}

      - alert: SallangDevHighErrorLogs
        expr: increase(logback_events_total{level="error", application="sallang-backend-dev"}[10m]) > 5
        for: 0m
        labels:
          severity: warning
          team: sallang
          environment: dev
        annotations:
          summary: "Sallang dev emitted ERROR logs"
          description: {% raw %}"Sallang dev emitted more than 5 ERROR logs in 10 minutes (count: {{ $value | humanize }})"{% endraw %}
