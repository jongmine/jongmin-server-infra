---
groups:
  - name: infrastructure_alerts
    interval: 30s
    rules:
      - alert: HighCPUUsage
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 5m
        labels:
          severity: warning
          team: infra
        annotations:
          summary: "High CPU usage detected"
          description: {% raw %}"CPU usage is above 80% for more than 5 minutes (current: {{ $value | humanize }}%)"{% endraw %}

      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
        for: 5m
        labels:
          severity: warning
          team: infra
        annotations:
          summary: "High memory usage detected"
          description: {% raw %}"Memory usage is above 85% for more than 5 minutes (current: {{ $value | humanize }}%)"{% endraw %}

      - alert: DiskSpaceWarning
        expr: (1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|fuse.lxcfs"} / node_filesystem_size_bytes{fstype!~"tmpfs|fuse.lxcfs"})) * 100 > 80
        for: 5m
        labels:
          severity: warning
          team: infra
        annotations:
          summary: "Disk space running low"
          description: {% raw %}"Disk usage on {{ $labels.mountpoint }} is above 80% (current: {{ $value | humanize }}%)"{% endraw %}

      - alert: DiskSpaceCritical
        expr: (1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|fuse.lxcfs"} / node_filesystem_size_bytes{fstype!~"tmpfs|fuse.lxcfs"})) * 100 > 90
        for: 2m
        labels:
          severity: critical
          team: infra
        annotations:
          summary: "Disk space critically low"
          description: {% raw %}"Disk usage on {{ $labels.mountpoint }} is above 90% (current: {{ $value | humanize }}%)"{% endraw %}

      - alert: NodeDown
        expr: up{job="node-exporter"} == 0
        for: 1m
        labels:
          severity: critical
          team: infra
        annotations:
          summary: "Node Exporter is down"
          description: {% raw %}"Node Exporter on {{ $labels.instance }} has been down for more than 1 minute"{% endraw %}

      - alert: ContainerDown
        expr: count by(name) (time() - container_last_seen{name!~"POD|k8s_.*", name!=""} > 60) > 0
        for: 1m
        labels:
          severity: warning
          team: infra
        annotations:
          summary: "Container is down"
          description: {% raw %}"Container {{ $labels.name }} has been down for more than 1 minute"{% endraw %}

      - alert: HighContainerMemoryUsage
        # name!="" : Docker 컨테이너만 (systemd cgroup 제외)
        # > 0 필터: 메모리 제한이 설정된 컨테이너만 (무제한 컨테이너 제외)
        expr: |
          (
            container_memory_usage_bytes{name!="", name!~"POD|k8s_.*"}
            /
            container_spec_memory_limit_bytes{name!="", name!~"POD|k8s_.*"}
          ) * 100 > 90
          and
          container_spec_memory_limit_bytes{name!="", name!~"POD|k8s_.*"} > 0
        for: 5m
        labels:
          severity: warning
          team: infra
        annotations:
          summary: "Container memory usage is high"
          description: {% raw %}"Container {{ $labels.name }} is using more than 90% of its memory limit (current: {{ $value | humanize }}%)"{% endraw %}
