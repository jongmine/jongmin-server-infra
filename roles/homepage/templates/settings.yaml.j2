title: "Jongmin's Home Cloud"
# Security: Allow access via this domain
allowedHosts:
  - "{{ domain_name }}"

background:
  image: https://images.unsplash.com/photo-1506443332154-b99123ef761c?auto=format&fit=crop&q=80&w=2000
  blur: 0
  saturate: 100
  brightness: 100
  opacity: 50

theme: dark
language: ko-KR
font:
  family: 'Inter'

# Layout settings
# Group names must match exactly with services.yaml
layout:
  System Monitor:
    style: row
    columns: 3 
  Infrastructure:
    style: row
    columns: 2 